# --- Server ---
PORT=3000
NODE_ENV=development
# Public origin of the site (used for cookie security + CORS on sockets)
PUBLIC_URL=http://localhost:3000

# Long random string used to sign session JWTs. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (Google Identity Services) ---
# Create an OAuth 2.0 Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add PUBLIC_URL
# to "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Comma-separated emails that are always admins (bootstraps the first admin).
ADMIN_EMAILS=you@example.com

# Initial access mode, can later be changed in the admin dashboard:
#   whitelist = new sign-ins are "pending" until an admin approves them
#   blacklist = new sign-ins are approved automatically; admins can ban
ACCESS_MODE=whitelist

# --- Database ---
# Leave empty to use the local JSON file store (data/db.json) - fine for dev.
# Set to a PostgreSQL connection string for production, e.g.
# DATABASE_URL=postgres://user:pass@localhost:5432/onslaught
DATABASE_URL=
DATABASE_SSL=false

# --- Development only ---
# Enables a name/email login form that bypasses Google. Ignored when NODE_ENV=production.
DEV_LOGIN=true
