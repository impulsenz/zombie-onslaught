{
  "name": "onslaught-terraform",
  "version": "1.0.0",
  "description": "Real-time co-op survival on an airless planet: hold the colony dome against a machine civilization, mine deep and escape.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i client/src/styles.css -o client/public/css/app.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i client/src/styles.css -o client/public/css/app.css --watch",
    "prestart": "npm run build:css",
    "start": "node server/index.js",
    "dev": "npm run build:css && node --watch server/index.js",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1",
    "tailwindcss": "^3.4.17"
  }
}
